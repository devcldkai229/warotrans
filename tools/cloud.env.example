# ~/.config/warotrans/cloud.env on the robot (chmod 600). Read by MODE=cloud of pi_run_semantic.sh / rbt2_mode.sh.
# Values come from the AWS demo stack in warotrans-system: terraform output iot_endpoint (envs/demo/persistent)
# and web_url (envs/demo/edge).
WARO_MQTT_HOST=xxxxxxxxxxxxxx-ats.iot.ap-southeast-1.amazonaws.com
WARO_RECORDER_URL=https://dxxxxxxxxxxxxx.cloudfront.net
# Optional: where the thing certificate lives (default ~/.config/warotrans/iot): <ROBOT_CODE>.cert.pem,
# <ROBOT_CODE>.private.key (chmod 600) and AmazonRootCA1.pem. Issued by scripts/iot-issue-cert.sh, never in a repo.
# WARO_IOT_DIR=/home/waro/.config/warotrans/iot
