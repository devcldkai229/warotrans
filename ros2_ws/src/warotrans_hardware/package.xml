<?xml version="1.0"?>
<package format="3">
  <name>warotrans_hardware</name>
  <version>0.1.0</version>
  <description>WaroTrans low-level hardware bridge, odometry, and diagnostics.</description>
  <maintainer email="dev@warotrans.local">WaroTrans Team</maintainer>
  <license>Proprietary</license>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>warotrans_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>diagnostic_msgs</depend>
  <exec_depend>python3-serial</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
