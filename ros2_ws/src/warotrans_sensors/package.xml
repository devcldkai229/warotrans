<?xml version="1.0"?>
<package format="3">
  <name>warotrans_sensors</name>
  <version>0.1.0</version>
  <description>Sensor device drivers and driver configuration: LiDAR now, IMU and
    other raw sensor sources later. Owns the driver layer only; it does not
    estimate state and does not consume its own output.</description>
  <maintainer email="dev@warotrans.local">WaroTrans Team</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Driver package for the LiDAR model actually used on the robot.
       Confirm the correct package name on the target ROS distro before
       relying on it in a launch file. -->
  <exec_depend>rplidar_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
