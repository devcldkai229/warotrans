<?xml version="1.0"?>
<package format="3">
  <name>warotrans_msgs</name>
  <version>0.1.0</version>
  <description>WaroTrans-specific ROS interfaces. Add custom messages only when standard ROS messages are insufficient.</description>
  <maintainer email="dev@warotrans.local">WaroTrans Team</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!--
    Uncomment together with the rosidl block in CMakeLists.txt when the first
    .msg/.srv/.action file is added. All four lines are required; omitting
    member_of_group is a common cause of "interface not found" at runtime.

    <buildtool_depend>rosidl_default_generators</buildtool_depend>
    <depend>std_msgs</depend>
    <depend>geometry_msgs</depend>
    <exec_depend>rosidl_default_runtime</exec_depend>
    <member_of_group>rosidl_interface_packages</member_of_group>
  -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
